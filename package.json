{
  "name": "themes.plexcord.club",
  "version": "1.0.0",
  "description": "Theme and snippet library for Plexcord, with the API behind its ThemeLibrary plugin",
  "homepage": "https://themes.plexcord.club",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Plexcord/themes.plexcord.club.git"
  },
  "bugs": "https://github.com/Plexcord/themes.plexcord.club/issues",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start -H 127.0.0.1 -p 8254",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test lib/*.test.ts",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": "^20.19 || ^22.12 || >=24.0"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "lucide-react": "1.59.0",
    "motion": "14.4.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
